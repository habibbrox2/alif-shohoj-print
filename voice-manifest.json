{
  "version": 4,
  "format": {
    "codec": "wav",
    "channels": "mono",
    "sample_rate_hz": 16000
  },
  "languages": [
    "bn",
    "en"
  ],
  "defaultLanguage": "bn",
  "customer": {
    "basePath": "audio/{lang}/",
    "clips": [
      {
        "id": "C01",
        "key": "welcome",
        "file": "C01.mp3",
        "text": {
          "bn": "স্বাগতম! আমি আপনাকে ধাপে ধাপে সাহায্য করব।",
          "en": "Welcome! I will guide you step by step."
        }
      },
      {
        "id": "C02",
        "key": "choose_service",
        "file": "C02.mp3",
        "text": {
          "bn": "আপনি কী প্রিন্ট করতে চান? নিচের বাটন থেকে বেছে নিন।",
          "en": "What would you like to print? Choose from the buttons below."
        }
      },
      {
        "id": "C03",
        "key": "service_tap",
        "file": "C03.mp3",
        "text": {
          "bn": "আপনার প্রয়োজনীয় সার্ভিসটির কার্ডে চাপুন।",
          "en": "Tap the card for the service you need."
        }
      },
      {
        "id": "C06",
        "key": "upload_prompt",
        "file": "C06.mp3",
        "text": {
          "bn": "এবার আপনার ফাইল বা ছবি আপলোড করুন।",
          "en": "Now upload your file or photo."
        }
      },
      {
        "id": "C07",
        "key": "uploading",
        "file": "C07.mp3",
        "text": {
          "bn": "আপলোড হচ্ছে, একটু অপেক্ষা করুন।",
          "en": "Uploading, please wait a moment."
        }
      },
      {
        "id": "C08",
        "key": "upload_done",
        "file": "C08.mp3",
        "text": {
          "bn": "আপলোড সম্পন্ন হয়েছে।",
          "en": "Upload complete."
        }
      },
      {
        "id": "C09",
        "key": "upload_failed",
        "file": "C09.mp3",
        "text": {
          "bn": "ছবি ঠিকমতো যায়নি। আবার চেষ্টা করুন।",
          "en": "The photo did not upload correctly. Please try again."
        }
      },
      {
        "id": "C10",
        "key": "choose_copies",
        "file": "C10.mp3",
        "text": {
          "bn": "কয় কপি লাগবে, সংখ্যাটি বেছে নিন।",
          "en": "Choose how many copies you need."
        }
      },
      {
        "id": "C11",
        "key": "choose_size",
        "file": "C11.mp3",
        "text": {
          "bn": "ছবির সাইজ বেছে নিন।",
          "en": "Choose the photo size."
        }
      },
      {
        "id": "C12",
        "key": "choose_color",
        "file": "C12.mp3",
        "text": {
          "bn": "রঙিন নাকি সাদা-কালো, সেটি বেছে নিন।",
          "en": "Choose colour or black-and-white."
        }
      },
      {
        "id": "C13",
        "key": "crop_rotate",
        "file": "C13.mp3",
        "text": {
          "bn": "প্রয়োজনে ছবি কাটুন বা ঘুরিয়ে নিন।",
          "en": "Crop or rotate the photo if needed."
        }
      },
      {
        "id": "C14",
        "key": "preview_confirm",
        "file": "C14.mp3",
        "text": {
          "bn": "প্রিভিউ দেখে নিন। সব ঠিক থাকলে \"কনফার্ম\" চাপুন।",
          "en": "Check the preview. If everything is correct, press “Confirm”."
        }
      },
      {
        "id": "C15",
        "key": "order_sent",
        "file": "C15.mp3",
        "text": {
          "bn": "আপনার অর্ডার দোকানে পাঠানো হয়েছে। দোকানদার দেখে নিশ্চিত করবেন।",
          "en": "Your order has been sent to the shop. The shopkeeper will review and confirm it."
        }
      },
      {
        "id": "C16",
        "key": "please_wait",
        "file": "C16.mp3",
        "text": {
          "bn": "অনুগ্রহ করে অপেক্ষা করুন।",
          "en": "Please wait."
        }
      },
      {
        "id": "C17",
        "key": "approved",
        "file": "C17.mp3",
        "text": {
          "bn": "আপনার অর্ডারটি অনুমোদিত হয়েছে। প্রিন্ট শুরু হচ্ছে।",
          "en": "Your order has been approved. Printing is starting."
        }
      },
      {
        "id": "C18",
        "key": "ready",
        "file": "C18.mp3",
        "text": {
          "bn": "আপনার প্রিন্ট প্রস্তুত। দোকান থেকে সংগ্রহ করুন।",
          "en": "Your print is ready. Please collect it from the shop."
        }
      },
      {
        "id": "C19",
        "key": "price_changed",
        "file": "C19.mp3",
        "text": {
          "bn": "দোকানদার দাম বদলেছেন। নতুন দাম দেখে সম্মতি দিন।",
          "en": "The shopkeeper has changed the price. Please review the new price and agree."
        }
      },
      {
        "id": "C20",
        "key": "rejected",
        "file": "C20.mp3",
        "text": {
          "bn": "দুঃখিত, আপনার অর্ডারটি গ্রহণ করা যায়নি। কারণটি নিচে দেখুন।",
          "en": "Sorry, your order could not be accepted. See the reason below."
        }
      },
      {
        "id": "C21",
        "key": "refund",
        "file": "C21.mp3",
        "text": {
          "bn": "টাকা দিলে আপনি ফেরত পাবেন।",
          "en": "If you have paid, you will receive a refund."
        }
      },
      {
        "id": "C22",
        "key": "payment_choose",
        "file": "C22.mp3",
        "text": {
          "bn": "পেমেন্ট করতে বিকাশ বা নগদ বেছে নিন, অথবা কাউন্টারে দিন।",
          "en": "Choose bKash or Nagad to pay, or pay at the counter."
        }
      },
      {
        "id": "C23",
        "key": "payment_success",
        "file": "C23.mp3",
        "text": {
          "bn": "পেমেন্ট সফল হয়েছে। ধন্যবাদ।",
          "en": "Payment successful. Thank you."
        }
      },
      {
        "id": "C24",
        "key": "shop_closed",
        "file": "C24.mp3",
        "text": {
          "bn": "দুঃখিত, দোকান এখন অর্ডার নিচ্ছে না। একটু পরে আসুন।",
          "en": "Sorry, the shop is not taking orders right now. Please come back later."
        }
      },
      {
        "id": "C25",
        "key": "offline",
        "file": "C25.mp3",
        "text": {
          "bn": "ইন্টারনেট সংযোগ নেই। সংযোগ দেখে আবার চেষ্টা করুন।",
          "en": "No internet connection. Check the connection and try again."
        }
      },
      {
        "id": "C26",
        "key": "privacy_note",
        "file": "C26.mp3",
        "text": {
          "bn": "আপনার তথ্য নিরাপদ। কাজ শেষে ফাইল মুছে ফেলা হবে।",
          "en": "Your information is safe. Files will be deleted after the job is done."
        }
      },
      {
        "id": "C27",
        "key": "goodbye",
        "file": "C27.mp3",
        "text": {
          "bn": "ধন্যবাদ! আবার আসবেন।",
          "en": "Thank you! Come again."
        }
      }
    ],
    "retiredIds": [
      "C04",
      "C05"
    ]
  },
  "shop": {
    "basePath": "sounds/",
    "clips": [
      {
        "id": "S01",
        "key": "new_order",
        "file": "S01.mp3",
        "text": {
          "bn": "নতুন অর্ডার এসেছে।",
          "en": "A new order has arrived."
        }
      },
      {
        "id": "S02",
        "key": "pending_reminder",
        "file": "S02.mp3",
        "text": {
          "bn": "একটি অর্ডার এখনো অপেক্ষায় আছে।",
          "en": "One order is still pending."
        }
      },
      {
        "id": "S03",
        "key": "paper_empty",
        "file": "S03.mp3",
        "text": {
          "bn": "প্রিন্টারে কাগজ শেষ।",
          "en": "The printer is out of paper."
        }
      },
      {
        "id": "S04",
        "key": "ink_low",
        "file": "S04.mp3",
        "text": {
          "bn": "প্রিন্টারে কালি কম।",
          "en": "Printer ink is low."
        }
      },
      {
        "id": "S05",
        "key": "printer_disconnected",
        "file": "S05.mp3",
        "text": {
          "bn": "প্রিন্টার সংযোগ বিচ্ছিন্ন।",
          "en": "Printer disconnected."
        }
      },
      {
        "id": "S06",
        "key": "offline_mode",
        "file": "S06.mp3",
        "text": {
          "bn": "ইন্টারনেট নেই, অফলাইন মোডে চলছে।",
          "en": "No internet, running in offline mode."
        }
      }
    ]
  },
  "commands": {
    "basePath": "audio/{lang}/",
    "clips": [
      {
        "id": "VC01",
        "key": "cmd_next",
        "file": "VC01.mp3",
        "text": {
          "bn": "পরের ধাপে যাচ্ছি।",
          "en": "Going to the next step."
        }
      },
      {
        "id": "VC02",
        "key": "cmd_back",
        "file": "VC02.mp3",
        "text": {
          "bn": "আগের ধাপে ফিরছি।",
          "en": "Going back."
        }
      },
      {
        "id": "VC03",
        "key": "cmd_confirm",
        "file": "VC03.mp3",
        "text": {
          "bn": "অর্ডার নিশ্চিত করা হচ্ছে।",
          "en": "Confirming your order."
        }
      },
      {
        "id": "VC04",
        "key": "cmd_copies_up",
        "file": "VC04.mp3",
        "text": {
          "bn": "এক কপি বাড়ানো হয়েছে।",
          "en": "One copy added."
        }
      },
      {
        "id": "VC05",
        "key": "cmd_copies_down",
        "file": "VC05.mp3",
        "text": {
          "bn": "এক কপি কমানো হয়েছে।",
          "en": "One copy removed."
        }
      },
      {
        "id": "VC06",
        "key": "cmd_color",
        "file": "VC06.mp3",
        "text": {
          "bn": "রঙিন প্রিন্ট বাছা হয়েছে।",
          "en": "Colour print selected."
        }
      },
      {
        "id": "VC07",
        "key": "cmd_bw",
        "file": "VC07.mp3",
        "text": {
          "bn": "সাদা-কালো প্রিন্ট বাছা হয়েছে।",
          "en": "Black-and-white selected."
        }
      },
      {
        "id": "VC08",
        "key": "cmd_replay",
        "file": "VC08.mp3",
        "text": {
          "bn": "আবার শোনাচ্ছি।",
          "en": "Playing it again."
        }
      },
      {
        "id": "VC09",
        "key": "cmd_help",
        "file": "VC09.mp3",
        "text": {
          "bn": "বলতে পারেন: পরের ধাপ, পেছনে যাও, কনফার্ম করো, কপি বাড়াও, অথবা থামো।",
          "en": "You can say: next, back, confirm, more copies, or stop."
        }
      },
      {
        "id": "VC10",
        "key": "cmd_stop",
        "file": "VC10.mp3",
        "text": {
          "bn": "ঠিক আছে, থামছি।",
          "en": "Okay, stopped."
        }
      },
      {
        "id": "VC11",
        "key": "cmd_approve",
        "file": "VC11.mp3",
        "text": {
          "bn": "অনুমোদন করা হয়েছে।",
          "en": "Order approved."
        }
      },
      {
        "id": "VC12",
        "key": "cmd_reject",
        "file": "VC12.mp3",
        "text": {
          "bn": "বাতিলের কারণ বেছে নিন।",
          "en": "Choose a reason to reject."
        }
      }
    ]
  },
  "tts": {
    "voice": "bn-BD",
    "templates": [
      {
        "key": "total_price",
        "text": {
          "bn": "আপনার মোট দাম {amount} টাকা।",
          "en": "Your total is {amount} taka."
        },
        "vars": [
          "amount"
        ]
      },
      {
        "key": "pickup_code",
        "text": {
          "bn": "আপনার পিকআপ কোড {code}।",
          "en": "Your pickup code is {code}."
        },
        "vars": [
          "code"
        ]
      },
      {
        "key": "order_number",
        "text": {
          "bn": "আপনার অর্ডার নম্বর {number}।",
          "en": "Your order number is {number}."
        },
        "vars": [
          "number"
        ]
      }
    ],
    "neverSpeak": [
      "nid_number",
      "full_name",
      "phone"
    ]
  }
}
