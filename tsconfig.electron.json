{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["electron/**/*.ts", "src/shared/types.ts", "src/shared/desktop-api.ts"],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
